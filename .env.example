# =============================================================================
# Мистер Модератор — пример файла окружения
# Скопируй в `.env` и заполни своими значениями:  cp .env.example .env
# ВАЖНО: `.env` не коммитится (он в .gitignore). Здесь — только заглушки.
# =============================================================================

# === MAX Bot ===
# Токен бота с платформы MAX для партнёров (на хакатоне выдают организаторы).
# Нужен боту и планировщику; без него API работает, но не шлёт уведомления.
MAX_BOT_TOKEN=

# === App ===
DEBUG=false
# true  — каждый запрос к API обязан нести заголовок X-Max-Init-Data с валидной подписью MAX
# false — демо-режим: все запросы API выполняются от тестового старосты группы TEST-GROUP-01
STRICT_AUTH=false
# true  — при старте API очищает БД и наполняет её тестовыми данными из seed/test_data.json
# false — БД не трогается, API работает с текущими данными
USE_TEST_DATA=false
USE_TEST_DATA=false

# === Database ===
# В Docker значение переопределяется в docker-compose.yml (SQLite в volume sqlite_data).
# Для запуска без Docker из папки backend/:
DATABASE_URL=sqlite+aiosqlite:///./mrmod.db
# Вариант с PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/DBNAME

# === Ports (на хосте) ===
WEB_PORT=8080
API_PORT=8000

# === Web (подставляются во фронтенд на этапе сборки образа) ===
VITE_API_BASE=/api
VITE_USE_API_MOCK=false

# === CORS (JSON-массив) ===
# Добавь сюда публичный адрес туннеля, если фронт и API на разных доменах.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# === Uploads (зарезервировано, в текущей версии не используется) ===
MAX_FILE_SIZE=20971520
