# =============================================================================
# MrModerator — example environment file
# Скопируй в `.env` и заполни своими значениями.
# ВАЖНО: не коммить `.env` — он в .gitignore.
# =============================================================================

# === MAX Bot ===
# Токен получи у @MasterBot в MAX
MAX_BOT_TOKEN=

# === App ===
DEBUG=false
STRICT_AUTH=false
USE_TEST_DATA=false

# === Database ===
DATABASE_URL=

# При переезде на постгр
# Пароль придумай сам. НЕ используй дефолтные значения в проде.
# Для локальной разработки без Docker — localhost:5432
# В Docker compose сам подменит хост на `db` через environment.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/DBNAME
# POSTGRES_USER=USER
# POSTGRES_PASSWORD=PASSWORD
# POSTGRES_DB=DBNAME
# POSTGRES_PORT=5432

# === Web ===
WEB_PORT=8080
API_PORT=8000
VITE_API_BASE=/api/v1
VITE_USE_API_MOCK=false

# === CORS (JSON-строка, не CSV) ===
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# === Uploads ===
MAX_FILE_SIZE=20971520